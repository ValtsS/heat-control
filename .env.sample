PORT=8005
INFLUX_TOKEN=
INFLUX_URL=http://docker:8086
ORG=my-org

# forecast – generic pluggable (open-meteo free, no key; solcast needs key)
FORECAST_PROVIDER=open-meteo
# PV arrays configurable: 3kW E 35° + 10kW S 45° (azimuth 0=S -90=E 90=W)
PV_ARRAYS=[{"kWp":3,"tilt":35,"azimuth":-90},{"kWp":10,"tilt":45,"azimuth":0}]
PV_EFFICIENCY=0.85
LAT=57
LON=25
FORECAST_DAYS=3
# forecast poll interval, human-readable: "1h", "6h" (6h for solcast 10/day)
FORECAST_INTERVAL=1h
FORECAST_SQLITE=./data/heat.db
# stale forecast older than this → treated as no-data (sun-gate only)
FORECAST_MAX_AGE=6h
# solcast (if FORECAST_PROVIDER=solcast)
SOLCAST_API_KEY=
SOLCAST_SITE_ID=

# legionella 60C every 7 days (thermostat caps ~63C, never above 65)
LEGIONELLA_TEMP=60
LEGIONELLA_INTERVAL=7d
# min time at temp to count as "hot" (20m)
LEGIONELLA_MIN_DURATION=20m

# tank horizon planner – from measured stats (150L, 55.8→50 over 8.5h ≈2.85 kWh/day loss,
# good-day cycle 8.98 kWh ≈6.1 kWh/day usage)
TANK_LITRES=150
TARGET_TEMP=55
TANK_MIN_TEMP=40
TANK_LOSS_KWH_PER_DAY=2.85
USAGE_KWH_PER_DAY=6.1
MAX_BANK_DEG=7
TANK_MAX_TEMP=63

# control
HYSTERESIS_DEG=1
# offline solar gate elevation (no forecast) – heat only if sun above this
MIN_ELEV_DEG=12
# daily hot-water guarantee (morning window, LOCAL hour) – hard override, may import up to MORNING_TEMP
MORNING_TEMP=40
MORNING_START_HOUR=6
MORNING_END_HOUR=10

# data dir for sqlite is ./data (docker volume)
