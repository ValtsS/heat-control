# ── HTTP server ──────────────────────────────────────────────────────────────
# Port the web server listens on (GET /power, /allow?temp=&relay=, /forecast)
PORT=8005

# ── InfluxDB – source of the power reading ───────────────────────────────────
# Required. The available-power signal comes from the grid/phase reading.
INFLUX_URL=http://docker:8086   # InfluxDB server URL (http://docker:8086 inside compose)
INFLUX_TOKEN=                    # InfluxDB auth token (required)
ORG=my-org                       # InfluxDB organization (required)
# Bucket / measurement / field read for the net surplus on the boiler's phase (W).
# active_grid_B_power_W = net power on that phase: positive = export, negative = import.
# Change only if your inverter stores a different field.
INFLUX_BUCKET=solar
INFLUX_MEASUREMENT=inverter-stats
INFLUX_FIELD=active_grid_B_power_W
# Look-back window for the "latest" reading, human-readable ("3m", "1m")
INFLUX_RANGE=3m

# ── Forecast – pluggable provider ────────────────────────────────────────────
# open-meteo = free, no key. solcast = needs SOLCAST_API_KEY + SOLCAST_SITE_ID
FORECAST_PROVIDER=open-meteo
# PV arrays: kWp (installed peak), tilt, azimuth (0=S, -90=E, 90=W). Your setup:
# 3.6 kW east/south-east 30° (compass ~110°) + 14.5 kW south 45° (compass ~170°).
PV_ARRAYS=[{"kWp":3.6,"tilt":30,"azimuth":-70},{"kWp":14.5,"tilt":45,"azimuth":-10}]
# Inverter/wiring/derate efficiency (0.85 = 85%) applied to forecast PV output
PV_EFFICIENCY=0.85
# Site location used by forecast + sun-elevation fallback
LAT=57
LON=25
# How many days of hourly forecast to fetch (3 is enough for today + tomorrow bank)
FORECAST_DAYS=3
# Forecast poll interval, human-readable. "1h" for open-meteo; set "6h" for solcast (10 req/day)
FORECAST_INTERVAL=1h
# SQLite file for forecast cache + legionella last-hot state (auto-creates data/)
FORECAST_SQLITE=./data/heat.db
# Forecast older than this is treated as no-data → falls back to sun-gate only
FORECAST_MAX_AGE=6h

# ── Solcast (only when FORECAST_PROVIDER=solcast) ────────────────────────────
SOLCAST_API_KEY=
SOLCAST_SITE_ID=

# ── Legionella – 60 °C safety ────────────────────────────────────────────────
# Temp (°C) that must be reached to "reset" the timer; thermostat caps ~63 °C (max 65)
LEGIONELLA_TEMP=60
# Max time between reaching LEGIONELLA_TEMP; after this, heat is forced (grid) until hot
LEGIONELLA_INTERVAL=7d
# Min time the temp must be sustained before it counts as "hot" (20m)
LEGIONELLA_MIN_DURATION=20m

# ── Tank model (used by the MPC optimizer + planTank fallback) ───────────────
# Calibrated from measured stats: 150 L, 55.8→50 °C over 8.5 h (≈2.85 kWh/day passive loss),
# and a good-day 8.98 kWh heating cycle (≈6.1 kWh/day usage).
TANK_LITRES=150            # boiler volume (L) – drives kWh/°C energy model
TARGET_TEMP=55             # end-of-day target tank temp (°C)
TANK_MIN_TEMP=40           # cold-water floor used in the energy-need math (°C)
TANK_LOSS_KWH_PER_DAY=2.85 # passive heat loss per day (kWh)
USAGE_KWH_PER_DAY=6.1      # hot-water draws per day (kWh; NOT modeled as a continuous leak – see AGENTS.md)
MAX_BANK_DEG=7             # max °C we preheat above TARGET_TEMP when tomorrow's solar is poor
TANK_MAX_TEMP=63           # thermostat ceiling (°C) – never assumed above 65
# Only the boiler's phase share of the forecast reaches the heater. The arrays total
# 13 kWp across 3 phases, so the boiler sees ~1/3. Set lower if the boiler phase is
# smaller / shares with other loads. Used to size banking & self-consumption.
BOILER_PHASE_SHARE=0.33

# ── MPC rolling-horizon scheduler (replaces the heuristic bank/gate logic) ────
# Horizon (hours) for the optimizer. Re-solved on every /allow poll; 24h keeps it
# focused on today+tomorrow (longer horizons drag in day-2 floor pressure).
MPC_HORIZON_HOURS=24
# Discount (0..1) on the future value of stored heat. <1 means the solver will NOT
# import just to hold a warm tank at target (avoids night "banking"), but still
# captures free surplus (0-cost heat that raises the end-of-horizon temperature).
TERMINAL_FACTOR=0.5

# ── Control behaviour ────────────────────────────────────────────────────────
# Heater draw (W) – boiler is 2.4 kW single-phase
HEATER_WATTS=2496
# Hysteresis on the tank-temp decision (°C) to avoid relay chatter
HYSTERESIS_DEG=1
# Offline sun gate: with no/stale forecast, heat only when sun elevation ≥ this (°)
MIN_ELEV_DEG=12
# Daily hot-water guarantee. In this LOCAL-hour window:
#  - if tank < MORNING_TEMP → ALWAYS heat (may import) – hard floor, hot water every morning
# Winter: poor days import only here (near use, minimal overnight loss), not all day.
MORNING_TEMP=40
MORNING_START_HOUR=6
MORNING_END_HOUR=10
